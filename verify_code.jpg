<script>
    function macCallback_loginResult(status, message, market, userId, userName, sessionId, yybdm, yjxx) {
        if (status == 0) {
            utools.loadAjaxV2({
                url: "/Login/MacCreateLogin", data: {
                    userId: userId,
                    userName: userName,
                    sessionId: sessionId,
                    yybdm: yybdm,
                    yjxx: yjxx
                },
                success: function (json) {
                    if (json) {
                        if (json.Status == 0) {
                            window.location.reload();
                        } else {
                            window.location.href = "/Login";
                        }
                    }
                    else {
                        window.location.href = "/Login";
                    }
                },
                error: function (xhr, textStatus, errorThrown) {
                    window.location.href = "/Login";
                },
                complete: function () {                    
                }
            });
        } else {
            window.location.href = "/Login";
        }
    }
</script>
        

